# Per-coach identifiers are read from mobile/coaches/<slug>.json by the lanes
# (app_identifier / team id), NOT hardcoded here, because every coach publishes
# under their OWN store account. This file intentionally stays minimal.
#
# If you ever need a default for local experiments, set them via env:
#   FASTLANE_APP_IDENTIFIER, FASTLANE_TEAM_ID
for_platform :ios do
  apple_id(ENV["APPLE_ID"]) if ENV["APPLE_ID"]
  team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
end
