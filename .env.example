NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (Coach Brain, plan generation, copilots). Features ship dark without it. ---
ANTHROPIC_API_KEY=your-anthropic-key
# Optional model overrides (defaults: chat=claude-sonnet-4-6, plans=claude-opus-4-8)
# COACH_BRAIN_MODEL=claude-sonnet-4-6
# PLAN_GENERATOR_MODEL=claude-opus-4-8

# --- Web Push (proactive reminders). Generated VAPID keypair — no external account. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT=mailto:soporte@performlabs.app
# Secret for the proactive-nudge cron (/api/cron/nudges). Vercel Cron sends it as a Bearer token.
CRON_SECRET=generate-a-long-random-string
