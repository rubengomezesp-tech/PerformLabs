NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- RevenueCat (RG Coach web checkout -> session balance). Server-only. ---
# Use a long random value and configure the same Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_AUTH_TOKEN=generate-a-long-random-string
REVENUECAT_APP_ID=app50094ffcb3
REVENUECAT_WORKSPACE_DOMAIN=miembros.rubengomezcoaching.com
# Keep false in production; enable only for an intentional sandbox webhook test.
REVENUECAT_ACCEPT_SANDBOX=false

# --- RG Coach isolated member access email (server-only). ---
# Only the exact workspace below bypasses the shared Supabase SMTP transport.
RG_COACH_MAGIC_LINK_WORKSPACE_ID=your-rg-coach-workspace-uuid
RG_COACH_RESEND_API_KEY=your-rg-coach-resend-api-key
RG_COACH_RESEND_FROM=Rubén · RG Coach <acceso@auth.rubengomezcoaching.com>
# Internal recipient for new diagnostic alerts (defaults to Rubén's account).
RG_COACH_LEADS_TO=rubengomezesp@gmail.com
# Long random server-only value used to HMAC rate-limit identifiers.
RG_COACH_RATE_LIMIT_SECRET=generate-a-long-random-string

# --- Cloudinary (image CDN). Optimizes exercise/recipe images via fetch delivery. ---
# Cloud name only — fetch URLs are unsigned and need no secret. Falls back to a
# baked-in default if unset, so images still render. Set per environment to use
# your own Cloudinary account (Settings > Product environment > Cloud name).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# --- AI (Coach Brain, plan generation, copilots). Features ship dark without it. ---
ANTHROPIC_API_KEY=your-anthropic-key
# Optional model overrides (defaults: chat=claude-sonnet-4-6, plans=claude-opus-4-8)
# COACH_BRAIN_MODEL=claude-sonnet-4-6
# PLAN_GENERATOR_MODEL=claude-opus-4-8

# --- Web Push (proactive reminders). Generated VAPID keypair — no external account. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT=mailto:soporte@performlabs.app
# Secret for the proactive-nudge cron (/api/cron/nudges). Vercel Cron sends it as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# --- Stripe (payments + Connect Standard). Billing ships dark without these. ---
# Test keys from Dashboard > Developers. Use sk_test_/pk_test_ first.
STRIPE_SECRET_KEY=sk_test_your-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Connect > Settings > "OAuth" client id (ca_...). Enables coach onboarding.
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id
# Set when you create the webhook endpoint at /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Recurring Price id (price_...) for the platform's monthly plan billed to coaches.
STRIPE_PLATFORM_PRICE_ID=price_your-platform-plan
# Platform commission kept from each connected-account charge (percent). Default 25.
STRIPE_APPLICATION_FEE_PERCENT=25
